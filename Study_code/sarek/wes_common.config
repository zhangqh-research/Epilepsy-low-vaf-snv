params {
  validate_params = false

  igenomes_base = null
  snpeff_cache = null
  vep_cache = null
  genome = null
  igenomes_ignore = true

  
  wes = true
  intervals = "/path/to/references/wholeExonBed/company/company_use_agilent_region.bed"

  
  fasta = "/path/to/references/refgenome/gatk-b37/comp_genome/human_g1k_v37_modified.fasta"
  fasta_fai = "/path/to/references/refgenome/gatk-b37/comp_genome/human_g1k_v37_modified.fasta.fai"
  dict = "/path/to/references/refgenome/gatk-b37/comp_genome/human_g1k_v37_modified.dict"
  bwa = "/path/to/references/refgenome/gatk-b37/comp_genome/"

  dbsnp = "/path/to/references/gatk_bundle/b37/dbsnp_138.b37.vcf.gz"
  dbsnp_tbi = "/path/to/references/gatk_bundle/b37/dbsnp_138.b37.vcf.gz.tbi"
  known_snps = "/path/to/references/gatk_bundle/b37/dbsnp_138.b37.vcf.gz"
  known_snps_tbi = "/path/to/references/gatk_bundle/b37/dbsnp_138.b37.vcf.gz.tbi"
  known_indels = "/path/to/references/gatk_bundle/b37/{1000G_phase1,Mills_and_1000G_gold_standard}.indels.b37.vcf.gz"
  known_indels_tbi = "/path/to/references/gatk_bundle/b37/{1000G_phase1,Mills_and_1000G_gold_standard}.indels.b37.vcf.gz.tbi"

  
  trim_fastq = false
}

process {
  executor = 'slurm'
  queue = 'fat'

  
  cpus = 1
  memory = 8.GB
  time = 4.h

  
  withName: /.*BUILD_INTERVALS.*/ {
    cpus = 1
    memory = 8.GB
    time = 1.h
    queue = 'fat'
  }

  withName: /.*CREATE_INTERVALS.*/ {
    cpus = 1
    memory = 8.GB
    time = 1.h
    queue = 'fat'
  }

  withName: /.*BGZIPTABIX.*/ {
    cpus = 1
    memory = 8.GB
    time = 1.h
    queue = 'fat'
  }

  
  withName: /.*FASTQC.*/ {
    cpus = 2
    memory = 16.GB
    time = 6.h
    queue = 'fat'
  }

  withName: /.*FASTP.*/ {
    cpus = 4
    memory = 12.GB
    time = 6.h
    queue = 'fat'
  }

  
  withName: /.*BWAMEM.*/ {
    cpus = 8
    memory = 32.GB
    time = 12.h
    queue = 'fat'
  }

  
  withName: /.*MERGE_BAM.*/ {
    cpus = 2
    memory = 8.GB
    time = 6.h
    queue = 'fat'
  }

  withName: /.*INDEX_MERGE_BAM.*/ {
    cpus = 2
    memory = 8.GB
    time = 4.h
    queue = 'fat'
  }

  
  withName: /.*MARKDUPLICATES.*/ {
    cpus = 4
    memory = 120.GB
    time = 16.h
    queue = 'fat'
  }

  
  withName: /.*BASERECALIBRATOR.*/ {
    cpus = 4
    memory = 32.GB
    time = 12.h
    queue = 'fat'
  }

  withName: /.*APPLYBQSR.*/ {
    cpus = 4
    memory = 40.GB
    time = 16.h
    queue = 'fat'
  }

  
  withName: /.*BAM_TO_CRAM.*/ {
    cpus = 4
    memory = 16.GB
    time = 8.h
    queue = 'fat'
  }

  withName: /.*INDEX_CRAM.*/ {
    cpus = 2
    memory = 12.GB
    time = 6.h
    queue = 'fat'
  }

  
  withName: /.*SAMTOOLS_STATS.*/ {
    cpus = 2
    memory = 12.GB
    time = 8.h
    queue = 'fat'
  }

  withName: /.*SAMTOOLS.*/ {
    cpus = 2
    memory = 12.GB
    time = 8.h
    queue = 'fat'
  }

  withName: /.*MOSDEPTH.*/ {
    cpus = 2
    memory = 12.GB
    time = 8.h
    queue = 'fat'
  }

  
  withName: /.*BCFTOOLS.*/ {
    cpus = 2
    memory = 16.GB
    time = 8.h
    queue = 'fat'
  }

  withName: /.*VCFTOOLS.*/ {
    cpus = 2
    memory = 16.GB
    time = 8.h
    queue = 'fat'
  }

  withName: /.*TABIX.*/ {
    cpus = 1
    memory = 8.GB
    time = 4.h
    queue = 'fat'
  }

  withName: /.*MULTIQC.*/ {
    cpus = 2
    memory = 24.GB
    time = 4.h
    queue = 'fat'
  }
}
singularity {
  enabled = true
  autoMounts = true
}
