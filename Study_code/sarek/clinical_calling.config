includeConfig "wes_common.config"

params.vep_cache = "/path/to/user_workspace/reference/homo_sapiens_vep_115_GRCh37"
params.vep_cache_version = "115"
params.vep_genome = "GRCh37"
params.vep_species = "homo_sapiens"
params.vep_custom_args = "--everything --filter_common --per_gene --total_length --offline --format vcf --fasta /path/to/user_workspace/reference/GRCh37_FASTA/Homo_sapiens.GRCh37.dna.primary_assembly.fa"
params.vep_out_format = "vcf"

process {
  
  withName: /.*MUTECT2_PAIRED.*/ {
    cpus = 8
    memory = 80.GB
    time = 24.h
    queue = 'fat'
  }
  
  withName: /.*MUSE.*/ {
    cpus = 4
    memory = 40.GB
    time = 12.h
    queue = 'fat'
  }

  
  withName: /.*GETPILEUPSUMMARIES.*/ {
    cpus = 2
    memory = 16.GB
    time = 8.h
    queue = 'fat'
  }

  withName: /.*GATHERPILEUPSUMMARIES.*/ {
    cpus = 1
    memory = 8.GB
    time = 4.h
    queue = 'fat'
  }

  withName: /.*CALCULATECONTAMINATION.*/ {
    cpus = 2
    memory = 16.GB
    time = 4.h
    queue = 'fat'
  }

  withName: /.*FILTERMUTECTCALLS.*/ {
    cpus = 4
    memory = 32.GB
    time = 12.h
    queue = 'fat'
  }

  withName: /.*LEARNREADORIENTATIONMODEL.*/ {
    cpus = 2
    memory = 16.GB
    time = 6.h
    queue = 'fat'
  }

  withName: /.*MERGEMUTECTSTATS.*/ {
    cpus = 1
    memory = 8.GB
    time = 4.h
    queue = 'fat'
  }

  withName: /.*MERGE_MUTECT2.*/ {
    cpus = 2
    memory = 16.GB
    time = 8.h
    queue = 'fat'
  }

  
  withName: /.*STRELKA_SOMATIC.*/ {
    cpus = 8
    memory = 24.GB
    time = 12.h
    queue = 'fat'
  }

  withName: /.*STRELKA_SINGLE.*/ {
    cpus = 8
    memory = 24.GB
    time = 12.h
    queue = 'fat'
  }

  withName: /.*MERGE_STRELKA.*/ {
    cpus = 2
    memory = 12.GB
    time = 6.h
    queue = 'fat'
  }

  
  withName: /.*FREEBAYES.*/ {
    cpus = 4
    memory = 32.GB
    time = 24.h
    queue = 'fat'
  }

  
  withName: /.*ENSEMBLVEP_VEP.*/ {
    container = "/path/to/user_workspace/nf-core_sarek/singularity_cache/ensembl-vep_perl-math-cdf-1e13f65f931a6954.img"
    cpus = 6
    memory = 80.GB
    time = 24.h
    queue = 'fat'
  }

  
  withName: /.*MUTECT2.*/ {
    cpus = 4
    memory = 32.GB
    time = 24.h
    queue = 'fat'
  }
}

executor {
  queueSize = 80
  submitRateLimit = '20/1min'
  pollInterval = '10 sec'
}

process {
  maxForks = 80
}
